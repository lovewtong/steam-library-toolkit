{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Steam library v2 (compatible array)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["appid", "name", "app_type", "run_id", "membership", "playtime_evidence"],
    "properties": {
      "appid": {"type": "integer", "minimum": 1, "maximum": 4294967295},
      "name": {"type": "string"},
      "developers": {"$ref": "#/$defs/manufacturers"},
      "publishers": {"$ref": "#/$defs/manufacturers"},
      "first_seen_at": {"type": ["string", "null"], "format": "date-time"},
      "first_seen_evidence": {"type": "object", "required": ["state"], "properties": {
        "state": {"enum": ["observed", "historical", "unknown"]},
        "source": {"enum": ["client_library", "saved_client_snapshot", "family_library", "saved_family_snapshot"]},
        "steam_id": {"type": "string", "pattern": "^[0-9]{17}$"},
        "run_id": {"type": "string", "minLength": 1}}},
      "app_type": {"type": "string"},
      "ownership": {"enum": ["account_license", "shared", "unknown"]},
      "family_evidence": {"type": "object", "required": ["source", "verified", "own", "shared", "owner_count", "exclude_reason"],
        "properties": {"source": {"const": "family_library"}, "verified": {"const": true},
          "own": {"type": "boolean"}, "shared": {"type": "boolean"},
          "owner_count": {"type": "integer", "minimum": 1, "maximum": 6}, "exclude_reason": {"const": 0}},
        "additionalProperties": false},
      "run_id": {"type": "string", "minLength": 1},
      "membership": {"type": "object", "required": ["state", "source"], "properties": {
        "state": {"enum": ["present", "candidate"]}, "source": {"type": "string"}}},
      "playtime_minutes": {"type": ["integer", "null"], "minimum": 0},
      "playtime_evidence": {"type": "object", "required": ["playtime_forever", "playtime_2weeks", "rtime_last_played"],
        "properties": {"playtime_forever": {"$ref": "#/$defs/time"}, "playtime_2weeks": {"$ref": "#/$defs/time"}, "rtime_last_played": {"$ref": "#/$defs/time"}}},
      "is_multiplayer": {"type": ["boolean", "null"]},
      "is_controller": {"type": ["boolean", "null"]}
    }
  },
  "$defs": {
    "manufacturers": {"type": ["array", "null"], "items": {"type": "string", "pattern": "\\S"}, "uniqueItems": true},
    "time": {
      "type": "object", "required": ["value", "state"],
      "properties": {"value": {"type": ["integer", "null"], "minimum": 0}, "state": {"enum": ["unknown", "known_zero", "known_nonzero", "historical"]}},
      "allOf": [
        {"if": {"properties": {"state": {"const": "unknown"}}}, "then": {"properties": {"value": {"type": "null"}}}},
        {"if": {"properties": {"state": {"const": "known_zero"}}}, "then": {"properties": {"value": {"const": 0}}}},
        {"if": {"properties": {"state": {"const": "known_nonzero"}}}, "then": {"properties": {"value": {"type": "integer", "minimum": 1}}}},
        {"if": {"properties": {"state": {"const": "historical"}}}, "then": {"properties": {"value": {"type": "integer", "minimum": 0}}}}
      ]
    }
  }
}
