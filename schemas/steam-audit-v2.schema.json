{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "run_id", "steam_id", "status", "membership", "sources", "summary"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "steam_id": {"type": ["string", "null"], "pattern": "^[0-9]{17}$"},
    "status": {"enum": ["ok", "degraded", "suspicious_change"]},
    "membership": {"enum": ["client_snapshot", "candidate_union"]},
    "sources": {"type": "object", "additionalProperties": {"type": "object", "required": ["state", "count"], "properties": {
      "state": {"enum": ["complete", "partial", "unavailable", "invalid", "account_mismatch"]},
      "count": {"type": "integer", "minimum": 0}}}},
    "summary": {"type": "object", "required": ["records", "types", "playtime_known"], "properties": {
      "records": {"type": "integer", "minimum": 0}, "types": {"type": "object"}, "playtime_known": {"type": "integer", "minimum": 0}}}
  }
}
